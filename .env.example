# Anthropic API-Key (Claude). Ohne diesen Key laufen alle Funktionen außer den
# KI-Aktionen (Status-Analyse, Deliverable-Erstellung, Fragen an die KI).
ANTHROPIC_API_KEY=

# Zu verwendendes Claude-Modell. Standard: claude-opus-4-8 (höchste Qualität).
# Für geringere Kosten kann z.B. claude-sonnet-5 verwendet werden.
ANTHROPIC_MODEL=claude-opus-4-8

# Ob personenbezogene Daten (E-Mail, Telefon, IBAN) vor dem Versand an die
# KI automatisch geschwärzt werden sollen ("true" | "false"). Standard: true.
PII_REDACTION_ENABLED=true

# Verzeichnis für die lokale SQLite-Datenbank. Standard: ./data
DATA_DIR=./data
